<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="moe.shizuku.manager" />
        <package android:name="roro.stellar.manager" />
    </queries>
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Plasma tray: Wi-Fi and network state. Changes go through the privileged shell. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Plasma v2 on Android 15 Xperia: the shell is an application overlay (granted via the privileged shell). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="roro.stellar.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Home-screen launchers for Linux applications are tiny generated APKs. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Brings Linux windows hosted in the launchers' tasks to the front. -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <permission
        android:name="moe.n4tsu.dextop.permission.CARDEX_RELAY"
        android:protectionLevel="normal" />
    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:resizeableActivity="true"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="moe.n4tsu.dextop.DextopCastOptionsProvider" />
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />
        <meta-data
            android:name="com.samsung.android.multidisplay.keep_process_alive"
            android:value="true" />
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <provider
            android:name="moe.n4tsu.dextop.privilege.EmbeddedPrivilegeProvider"
            android:authorities="${applicationId}.embedded_privilege"
            android:enabled="true"
            android:exported="true" />
        <receiver
            android:name="moe.n4tsu.dextop.privilege.EmbeddedPairingReceiver"
            android:exported="false" />
        <service
            android:name="moe.n4tsu.dextop.privilege.EmbeddedPairingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="wireless debugging pairing" />
        </service>
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.phone"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
        </activity>
        <activity
            android:name=".DesktopActivity"
            android:label="@string/app_name"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.desktop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
        </activity>
        <activity
            android:name=".DextopLauncherActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:documentLaunchMode="always"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Desktop layer of the Dextop window manager. Started as a
             secondary HOME on the Dextop display so it always stays below
             application windows; never offered as a default launcher. -->
        <activity
            android:name=".plasma.PlasmaDesktopActivity"
            android:label="@string/app_name"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.plasmadesktop"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Wallpaper.NoTitleBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".DextopCastRouteActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/DextopCastRouteTheme" />
        <activity
            android:name=".AndroidAutoMirrorActivity"
            android:label="@string/app_name"
            android:exported="false"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />
        <activity
            android:name=".CarCompanionPhoneActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.carcontrol"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|density|uiMode" />
        <activity
            android:name=".CoverBackButtonsActivity"
            android:label="@string/app_name"
            android:exported="false"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />
        <activity
            android:name=".CoverTrackpadActivity"
            android:label="@string/app_name"
            android:exported="false"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />
        <service
            android:name=".CardexRelayService"
            android:exported="true" />
        <service
            android:name=".MirrorService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/mirror_accessibility_service" />
        </service>
        <service
            android:name=".input.DextopSwipeInputMethodService"
            android:label="@string/dextop_swipe_ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/dextop_swipe_input_method" />
        </service>
        <service
            android:name=".plasma.DextopNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".DextopTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_dextop"
            android:label="@string/quick_settings_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <service
            android:name=".DextopDisplayTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_dextop_display"
            android:label="@string/quick_settings_display_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <receiver
            android:name=".CardexRecoveryReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="moe.n4tsu.dextop.action.CARDEX_INTERRUPTED" />
            </intent-filter>
        </receiver>
        <!-- Linux applications outside Plasma: one Android task per X window. -->
        <activity
            android:name=".linux.LinuxWindowActivity"
            android:exported="false"
            android:documentLaunchMode="always"
            android:autoRemoveFromRecents="true"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|density|uiMode|navigation"
            android:windowSoftInputMode="adjustResize" />
        <!-- A Linux window inside its launcher APK's task (opened by that launcher's Window
             activity), so the task carries the application's name and icon. -->
        <activity
            android:name=".linux.LinuxHostedWindowActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|density|uiMode|navigation"
            android:windowSoftInputMode="adjustResize" />
        <!-- A container's interactive shell (xterm.js on a PTY of the shell-side service). -->
        <activity
            android:name=".linux.LinuxTerminalActivity"
            android:exported="false"
            android:documentLaunchMode="always"
            android:autoRemoveFromRecents="true"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|density|uiMode|navigation"
            android:windowSoftInputMode="adjustResize" />
        <!-- A Linux dialog whose parent window is gone: floating, at its own size. -->
        <activity
            android:name=".linux.LinuxDialogActivity"
            android:exported="false"
            android:documentLaunchMode="always"
            android:autoRemoveFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|density|uiMode|navigation"
            android:windowSoftInputMode="adjustResize" />
        <!-- Keeps Linux applications running in the background, with an ongoing notification;
             forwards Linux notifications as Android notifications. -->
        <service
            android:name=".linux.LinuxSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Linux container session" />
        </service>
        <receiver
            android:name=".linux.LinuxSessionService$NotificationAction"
            android:exported="false" />
        <!-- Opened by the generated Linux launcher APKs and the Linux tab. -->
        <activity
            android:name=".linux.LinuxLaunchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="moe.n4tsu.dextop.action.LAUNCH_LINUX_APP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".linux.LinuxShortcutInstaller$Status"
            android:exported="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>

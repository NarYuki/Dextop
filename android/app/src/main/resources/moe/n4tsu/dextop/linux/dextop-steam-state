#!/usr/bin/python3
"""Recover missing Steam version metadata only when installed core files agree."""
from pathlib import Path
import os
import re
import sys
import zlib


def record(root, source):
    """Record only payload files whose installed bytes match the verified staging tree."""
    channel = (root / 'package/beta').read_text().strip()
    if not re.fullmatch(r'[A-Za-z0-9_]+', channel):
        raise ValueError('Invalid Steam channel')
    rows = []
    for staged in sorted(source.rglob('*')):
        name = staged.relative_to(source).as_posix()
        if any(c in name for c in '\r\n'):
            raise ValueError('Unsupported Steam payload path: ' + name)
        installed = root / name
        timestamp = int(staged.lstat().st_mtime)
        if staged.is_symlink():
            # Valve records links as size -2 and CRC32 of their target text,
            # including dangling links; never hash the resolved target file.
            target = os.readlink(staged)
            if not installed.is_symlink() or os.readlink(installed) != target:
                raise ValueError('Installed Steam link differs: ' + name)
            rows.append(f'{name},-2;{timestamp};{zlib.crc32(os.fsencode(target)) & 0xffffffff}\n')
            continue
        if staged.is_dir():
            if not installed.is_dir() or installed.is_symlink():
                raise ValueError('Missing installed Steam directory: ' + name)
            rows.append(f'{name}/,-1;{timestamp};0\n')
            continue
        if not installed.is_file() or installed.is_symlink():
            raise ValueError('Missing installed Steam file: ' + name)
        crc = 0
        size = 0
        with staged.open('rb') as expected, installed.open('rb') as actual:
            while True:
                block = expected.read(1024 * 1024)
                if actual.read(len(block) or 1) != block:
                    raise ValueError('Installed Steam file differs: ' + name)
                if not block:
                    break
                crc = zlib.crc32(block, crc)
                size += len(block)
        rows.append(f'{name},{size};{timestamp};{crc & 0xffffffff}\n')
    if not any(',-1;' not in row for row in rows):
        raise ValueError('Empty Steam payload')
    target = root / 'package' / ('steam_client_' + channel + '_linuxarm64.installed')
    temporary = target.with_name(target.name + '.dextop-staged')
    try:
        with temporary.open('w', encoding='utf-8', newline='\n') as stream:
            stream.writelines(rows)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, target)
    finally:
        temporary.unlink(missing_ok=True)
    return True


def repair(root):
    package = root / 'package'
    beta = package / 'beta'
    channel = beta.read_text().strip() if beta.is_file() else ''
    if not re.fullmatch(r'[A-Za-z0-9_]*', channel):
        return False
    stem = 'steam_client_' + (channel + '_' if channel else '') + 'linuxarm64'
    manifest = package / (stem + '.manifest')
    pending = package / stem
    installed = package / (stem + '.installed')
    stamp = package / 'droiddeck-installed'
    if manifest.exists() or not all(p.is_file() for p in (pending, installed, stamp)):
        return False
    data = pending.read_bytes()
    version = re.search(rb'"version"\s*"([0-9]+)"', data)
    if not version or version[1].decode() != stamp.read_text().strip():
        return False
    required = {'steamrtarm64/' + name for name in
                ('steam', 'steamclient.so', 'steamwebhelper', 'steamwebhelper.sh')}
    matched = set()
    for line in installed.read_text().splitlines():
        if ',' not in line:
            continue
        name, attributes = line.rsplit(',', 1)
        if name not in required:
            continue
        size, _, crc = attributes.split(';')
        path = root / name
        if not path.is_file() or path.stat().st_size != int(size):
            return False
        actual = 0
        with path.open('rb') as stream:
            for block in iter(lambda: stream.read(1024 * 1024), b''):
                actual = zlib.crc32(block, actual)
        if actual & 0xffffffff != int(crc):
            return False
        matched.add(name)
    if matched != required:
        return False
    staged = manifest.with_name(manifest.name + '.dextop-staged')
    with staged.open('wb') as stream:
        stream.write(data)
    os.replace(staged, manifest)
    print('Restored Steam version metadata after checking installed core files.', flush=True)
    return True


if __name__ == '__main__':
    try:
        if sys.argv[1] == '--record':
            record(Path(sys.argv[2]), Path(sys.argv[3]))
        else:
            repair(Path(sys.argv[1]))
    except (OSError, ValueError) as error:
        print('Steam metadata recovery skipped: ' + str(error), file=sys.stderr)
        if sys.argv[1] == '--record':
            sys.exit(1)

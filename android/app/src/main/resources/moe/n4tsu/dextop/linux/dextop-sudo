#!/usr/bin/python3
"""Runs the distribution's real sudo under fakeroot, where Android forbids setuid.

sudo itself checks the password, sudoers and PAM; fakeroot only supplies the uid 0 it
cannot obtain from Android. This is guest compatibility, not a security boundary against
the Android uid.
"""
import os
import shutil
import sys

SUDO = '/usr/bin/sudo'


def preserved(args):
    # -E keeps the environment, except what fakeroot and Dextop's preloads set themselves.
    names = ','.join(name for name in os.environ if name.replace('_', 'A').isalnum() and not name.startswith(('LD_', 'FAKEROOT', 'FAKED')) and name != 'PATH')
    result, index = [], 0
    while index < len(args):
        arg = args[index]
        index += 1
        if arg == '--':
            result.append(arg)
            result.extend(args[index:])
            break
        if not arg.startswith('-') or arg == '-':
            result.append(arg)
            result.extend(args[index:])
            break
        if arg in ('-E', '--preserve-env'):
            result.append('--preserve-env=' + names)
        elif not arg.startswith('--') and 'E' in arg[1:] and arg[1:].isalpha():
            rest = arg.replace('E', '')
            if rest != '-':
                result.append(rest)
            result.append('--preserve-env=' + names)
        else:
            result.append(arg)
            if arg in ('-u', '-g', '-C', '-D', '-h', '-p', '-r', '-t', '-U', '-T', '-R') and index < len(args):
                result.append(args[index])
                index += 1
    return result


def main(args):
    args = preserved(args)
    if os.geteuid() == 0:
        os.execv(SUDO, [SUDO] + args)
    fakeroot = shutil.which('fakeroot-tcp', path='/usr/bin:/bin') or shutil.which('fakeroot', path='/usr/bin:/bin') or 'fakeroot'
    environment = dict(os.environ)
    environment.update(FAKEROOTUID=str(os.getuid()), FAKEROOTGID=str(os.getgid()), FAKEROOTEUID='0', FAKEROOTEGID='0',
                       FAKEROOTSUID='0', FAKEROOTSGID='0', FAKEROOTFUID='0', FAKEROOTFGID='0')
    os.execve(fakeroot, [fakeroot, '--', SUDO] + args, environment)


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except OSError as error:
        print(f'sudo: {error}', file=sys.stderr)
        sys.exit(1)

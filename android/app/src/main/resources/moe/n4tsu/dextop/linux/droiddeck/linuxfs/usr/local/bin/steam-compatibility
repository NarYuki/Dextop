BL_LIBPATH_SETUP = """
bl_libpath() {
  export PROTON_USE_PIPEWIRE=${PROTON_USE_PIPEWIRE:-0}
  [ -n "${LD_LIBRARY_PATH:-}" ] || return 0
  local kept= dir old_ifs=$IFS
  IFS=:
  for dir in $LD_LIBRARY_PATH; do
    case $dir in
      "" | */steamrtarm64 | */steamrtarm64/*) ;;
      *) kept=${kept:+$kept:}$dir ;;
    esac
  done
  IFS=$old_ifs
  if [ -n "$kept" ]; then export LD_LIBRARY_PATH="$kept"; else unset LD_LIBRARY_PATH; fi
}
"""

BL_IDTECH3_SETUP = """
bl_idtech3() {
  BL_EXTRA_ARGS=()
  case "${SteamAppId:-${STEAM_COMPAT_APP_ID:-}}" in
    2200|2350|9010|6020) ;;
    *) return 0 ;;
  esac
  case " $* " in
    *r_fullscreen*|*r_mode*|*r_customwidth*|*r_customheight*)
      echo "droiddeck-proton: Quake-engine title; its launch options set the video mode, left as they are" >&2
      return 0 ;;
  esac
  w=${BL_WIDTH:-1280}
  h=${BL_HEIGHT:-720}
  BL_EXTRA_ARGS=(+set r_fullscreen 0 +set r_mode -1 +set r_customwidth "$w" +set r_customheight "$h")
  echo "droiddeck-proton: Quake-engine title: windowed at ${w}x${h}" >&2
}
"""

BL_DIRECTAUDIO_SETUP = """
bl_directaudio() {
  base=$1
  [ -n "${BL_DIRECTAUDIO:-}" ] || return 0
  [ -d "$BL_DIRECTAUDIO" ] || return 0
  version=$("$base/files/bin-arm64/wine" --version 2>/dev/null)
  major=${version#wine-}
  major=${major%%.*}
  if [ "$major" != "11" ]; then
    echo "droiddeck-proton: DirectAudio left off - it is built for Wine 11 and this Proton is '${version:-unknown}'. Pairing them would be silent rather than broken, so it is not worth guessing." >&2
    return 0
  fi
  winepulse="$base/files/lib/wine/aarch64-unix/winepulse.so"
  if [ ! -f "$winepulse" ]; then
    echo "droiddeck-proton: DirectAudio left off - no winepulse.so to read this Proton's audio interface from" >&2
    return 0
  fi
  if grep -aq PsCreateSystemThread "$winepulse"; then set=linux-wine11-systhread; else set=linux-wine11; fi
  da="$BL_DIRECTAUDIO/$set"
  if [ ! -d "$da/lib/wine" ]; then
    echo "droiddeck-proton: DirectAudio left off - no driver set for the $set interface is staged" >&2
    return 0
  fi
  WINEDLLPATH="$da/lib/wine${WINEDLLPATH:+:$WINEDLLPATH}"
  export WINEDLLPATH
  WINE_AUDIO_DRIVER="directaudio,pulse"
  export WINE_AUDIO_DRIVER
  pfx="${STEAM_COMPAT_DATA_PATH:-}/pfx"
  reg="$pfx/user.reg"
  if [ -f "$reg" ]; then
    for pair in system32:aarch64-windows syswow64:i386-windows; do
      dir="$pfx/drive_c/windows/${pair%%:*}"
      src="$da/lib/wine/${pair#*:}/winedirectaudio.drv"
      if [ -d "$dir" ] && [ -f "$src" ] && [ "$(readlink "$dir/winedirectaudio.drv" 2>/dev/null)" != "$src" ]; then
        ln -sfn "$src" "$dir/winedirectaudio.drv.bl-new" && mv -f "$dir/winedirectaudio.drv.bl-new" "$dir/winedirectaudio.drv"
      fi
    done
    key='[Software\\\\Wine\\\\Drivers]'
    if [ "$(readlink "$pfx/drive_c/windows/system32/winedirectaudio.drv" 2>/dev/null)" != "$da/lib/wine/aarch64-windows/winedirectaudio.drv" ]; then
      echo "droiddeck-proton: DirectAudio could not be placed in the prefix; Proton's own audio stays" >&2
    elif ! BL_KEY="$key" awk 'index($0, "[") == 1 { inside = index($0, ENVIRON["BL_KEY"] " ") == 1 } inside && index($0, "\\"Audio\\"=") == 1 { last = $0 } END { exit last != "\\"Audio\\"=\\"directaudio,pulse\\"" }' "$reg" 2>/dev/null; then
      printf '\\n%s %s\\n"Audio"="directaudio,pulse"\\n' "$key" "$(date +%s)" >> "$reg"
      echo "droiddeck-proton: DirectAudio selected in the prefix" >&2
      srv="${BL_WINE_SERVER_BASE:-/tmp/.wine-$(id -u)}/server-$(printf '%x-%x' $(stat -c '%d %i' "$pfx" 2>/dev/null || echo 0 0))/socket"
      if [ -S "$srv" ]; then
        echo "droiddeck-proton: a wineserver is already running for this prefix; DirectAudio may only engage on the next launch" >&2
      fi
    fi
  else
    echo "droiddeck-proton: no prefix yet - DirectAudio takes effect the next time this game starts" >&2
  fi
  echo "droiddeck-proton: DirectAudio ready (Wine $major, $set)" >&2
}
"""

LAUNCHER_SH = """#!/bin/bash
verb=$1; shift
steam_root=${STEAM_COMPAT_CLIENT_INSTALL_PATH:-${XDG_DATA_HOME:-$HOME/.local/share}/Steam}
for fake in /usr/local/lib/libfakeinput.so /usr/local/lib/libblsession.so; do
  if [ -f "$fake" ]; then
    case ":${LD_PRELOAD:-}:" in
      *":$fake:"*) ;;
      *) LD_PRELOAD="$fake${LD_PRELOAD:+:$LD_PRELOAD}"; export LD_PRELOAD ;;
    esac
  fi
done
audit=/usr/local/lib/libblaudit.so
if [ -n "${PROOT_FP_KEY:-}" ] && [ -f "$audit" ]; then
  case ":${LD_AUDIT:-}:" in
    *":$audit:"*) ;;
    *) LD_AUDIT="$audit${LD_AUDIT:+:$LD_AUDIT}"; export LD_AUDIT ;;
  esac
fi
depot=
libraries=$(printf '%%s\\n' "$steam_root" /mnt/droiddeck-sd; sed -n 's/^[[:space:]]*"path"[[:space:]]*"\\(.*\\)"[[:space:]]*$/\\1/p' "$steam_root/steamapps/libraryfolders.vdf" 2>/dev/null)
for name in %s; do
 best=0
 while IFS= read -r library; do
  candidate="$library/steamapps/common/$name"
  [ -d "$candidate/files/bin-arm64" ] && [ -x "$candidate/proton" ] || continue
  build=0
  read -r build _ 2>/dev/null < "$candidate/version"
  case $build in "" | *[!0-9]*) build=0 ;; esac
  if [ -z "$depot" ] || [ "$build" -gt "$best" ]; then
    depot=$candidate
    best=$build
  fi
 done <<< "$libraries"
 [ -n "$depot" ] && break
done
if [ -n "$depot" ]; then
  bl_components "$depot"
  bl_directaudio "$depot"
  bl_game_cpus
  bl_idtech3 "$@"
  bl_libpath
  BL_STORE_PROTON="$depot/proton"; export BL_STORE_PROTON
  bl_store_launch "$@"
  BL_STORE_ARGS=("$@")
  bl_run ${BL_TASKSET:-} /usr/local/bin/droiddeck-game-env "$depot/proton" "$verb" "$@" "${BL_EXTRA_ARGS[@]}"
fi
echo "droiddeck-proton: no ARM64 Proton depot yet - the client downloads one as this tool's dependency; retry the launch once it has" >&2
exit 1
"""
LAUNCHER_TEMPLATE = LAUNCHER_SH


def launcher_sh(sources=SOURCES):
    return (LAUNCHER_TEMPLATE % " ".join('"%s"' % n for n in sources)).replace(
        "verb=$1; shift", "verb=$1; shift\n" + BL_DIRECTAUDIO_SETUP + BL_GAME_CPUS_SETUP + BL_IDTECH3_SETUP
        + BL_COMPONENTS_SETUP + BL_LIBPATH_SETUP + BL_STORE_SETUP, 1)


LAUNCHER_SH = launcher_sh()


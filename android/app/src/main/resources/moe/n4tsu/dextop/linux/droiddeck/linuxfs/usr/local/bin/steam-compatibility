BL_STORE_SETUP = """
bl_store_launch() {
  [ "${verb:-}" = waitforexitandrun ] || return 0
  if [ -x /usr/local/bin/droiddeck-open-url ]; then
    mkdir -p /tmp/droiddeck-browser
    ln -sfn /usr/local/bin/droiddeck-open-url /tmp/droiddeck-browser/xdg-open
    [ -n "${BL_LAUNCH_DIR:-}" ] && printf '%s
' "$BL_LAUNCH_DIR" > /tmp/droiddeck-browser/launch-dir
    PATH="/tmp/droiddeck-browser:$PATH"; export PATH
  fi
  if [ "${BL_DEBUG_BROWSER:-}" = 1 ]; then
    WINEDEBUG="${WINEDEBUG:+$WINEDEBUG,}+shell,+winebrowser"; export WINEDEBUG
  fi
  [ -x /usr/local/bin/droiddeck-store-launch ] || return 0
  /usr/local/bin/droiddeck-store-launch "$@"
  [ $? -eq 10 ] && BL_STORE_EXIT=1
  return 0
}

bl_run() {
  if [ -n "${BL_STORE_EXIT:-}" ]; then
    "$@"
    rc=$?
    /usr/local/bin/droiddeck-store-launch --exited "${BL_STORE_ARGS[@]}" || true
    exit $rc
  fi
  exec "$@"
}
"""

BL_COMPONENTS_SETUP = """
bl_components() {
  base=$1
  cm_dir="${HOME:-/root}/.local/share/droiddeck-components"
  cm_list="$cm_dir/desired.tsv"
  [ "${verb:-}" = waitforexitandrun ] || return 0
  case "${STEAM_COMPAT_DATA_PATH:-}" in ''|*/compatdata/0|*/compatdata/0/|*/compatdata/0-*) return 0 ;; esac
  [ -f "$cm_list" ] || return 0
  cm_app=${STEAM_COMPAT_DATA_PATH}
  while [[ "$cm_app" == */ ]]; do cm_app=${cm_app%/}; done
  cm_app=${cm_app##*/}
  if [[ "$cm_app" =~ ^(-?)([0-9]+)$ ]]; then
    cm_sign=${BASH_REMATCH[1]}
    cm_digits=${BASH_REMATCH[2]}
    while [[ ${#cm_digits} -gt 1 && "$cm_digits" == 0* ]]; do cm_digits=${cm_digits#0}; done
    if [[ ${#cm_digits} -le 10 ]]; then
      cm_app=$((10#$cm_digits))
      [ "$cm_sign" = "-" ] && cm_app=$((-cm_app))
      if (( cm_app >= -2147483648 && cm_app <= 4294967295 && cm_app != 0 )); then
        (( cm_app < 0 )) && cm_app=$((cm_app + 4294967296))
      else
        cm_app=""
      fi
    else
      cm_app=""
    fi
  else
    cm_app=""
  fi
  if [ -z "$cm_app" ]; then
    echo "droiddeck-proton: components: invalid game prefix, left as it is" >&2
    return 0
  fi
  cm_tool=${base##*/}
  cm_build=$(awk 'NR == 1 { print $2 }' "$base/version" 2>/dev/null)
  cm_fixed=0
  cm_checked=0
  cm_selected=$(awk -F '\\t' -v app="$cm_app" -v tool="$cm_tool" -v build="$cm_build" '
    $2 == tool && $3 == build {
      rows[++count] = $0
      scopes[count] = $1
      comps[count] = $4
      if ($1 == app) specific[$4] = 1
    }
    END {
      for (i = 1; i <= count; i++)
        if (scopes[i] == app || (scopes[i] == "*" && !specific[comps[i]])) print rows[i]
    }
  ' "$cm_list")
  local cm_rows=() cm_files=() row h p
  local -A cm_sums=()
  while IFS=$'\\t' read -r scope t want comp rel sum src; do
    [ -n "$scope" ] || continue
    cm_rows+=("$comp"$'\\t'"$rel"$'\\t'"$sum"$'\\t'"$src")
    [ "$src" != "-" ] && [ -f "$base/$rel" ] && cm_files+=("$base/$rel")
  done <<< "$cm_selected"
  if [ ${#cm_files[@]} -gt 0 ]; then
    while read -r h p; do cm_sums["$p"]=$h; done < <(sha256sum -- "${cm_files[@]}" 2>/dev/null)
  fi
  for row in "${cm_rows[@]}"; do
    IFS=$'\\t' read -r comp rel sum src <<< "$row"
    cm_checked=$((cm_checked + 1))
    f="$base/$rel"
    if [ "$src" = "-" ]; then
      if [ -e "$f" ]; then rm -f "$f" && cm_fixed=$((cm_fixed + 1)); fi
      continue
    fi
    if [ -f "$f" ] && [ "${cm_sums[$f]:-}" = "$sum" ]; then continue; fi
    if [ ! -f "$src" ]; then
      echo "droiddeck-proton: components: $comp source missing ($src), left as it is" >&2
      continue
    fi
    mkdir -p "$(dirname "$f")"
    cp -f "$src" "$f.bl-new" && mv -f "$f.bl-new" "$f" || continue
    case "$rel" in *.so) chmod 755 "$f" ;; *) chmod 644 "$f" ;; esac
    cm_fixed=$((cm_fixed + 1))
  done
  [ "$cm_checked" -gt 0 ] && echo "droiddeck-proton: components: checked $cm_checked file(s) in $cm_tool for app $cm_app" >&2
  if [ "$cm_fixed" -gt 0 ]; then
    echo "droiddeck-proton: components: re-applied $cm_fixed of $cm_checked file(s) in $cm_tool before this launch" >&2
    printf '%s\\t%s\\t%s\\n' "$(date +%s)" "$cm_tool" "$cm_fixed" >> "$cm_dir/reapplied.log"
  fi
}
"""


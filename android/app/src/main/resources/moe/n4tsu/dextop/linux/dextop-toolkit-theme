#!/usr/bin/python3
"""Supply GTK and both Qt generations with the container's desktop theme."""

import argparse
import configparser
import io
import os
from pathlib import Path
import tempfile


def write_changed(path, content):
    if path.is_file() and path.read_text() == content:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as stream:
        temporary = Path(stream.name)
        stream.write(content)
    try:
        os.chmod(temporary, 0o644)
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def update_ini(path, section, values, defaults=()):
    config = configparser.ConfigParser(interpolation=None, strict=False)
    config.optionxform = str
    if path.is_file():
        config.read(path)
    if not config.has_section(section):
        config.add_section(section)
    for key, value in values.items():
        config[section][key] = value
    for key, value in dict(defaults).items():
        if key not in config[section]:
            config[section][key] = value
    result = io.StringIO()
    config.write(result, space_around_delimiters=False)
    write_changed(path, result.getvalue())
    return config


def apply(root, mode, home=Path('/root')):
    dark = mode == 'dark'
    config_home = root / home.relative_to('/') / '.config'
    theme = 'Adwaita-dark' if dark else 'Adwaita'
    for version in ('3.0', '4.0'):
        update_ini(config_home / f'gtk-{version}/settings.ini', 'Settings', {
            'gtk-application-prefer-dark-theme': '1' if dark else '0',
            'gtk-theme-name': theme,
        }, {'gtk-icon-theme-name': 'Adwaita', 'gtk-font-name': 'Noto Sans 10'})
    write_changed(config_home / 'dextop/gtk2-theme.rc',
                  f'gtk-theme-name="{theme}"\ngtk-icon-theme-name="Adwaita"\ngtk-font-name="Noto Sans 10"\n')
    for generation in ('qt5ct', 'qt6ct'):
        path = config_home / generation / f'{generation}.conf'
        scheme = f'/usr/share/{generation}/colors/{"darker" if dark else "airy"}.conf'
        config = update_ini(path, 'Appearance', {}, {
            'style': 'Fusion', 'icon_theme': 'Adwaita', 'standard_dialogs': 'default',
        })
        previous = config['Appearance'].get('color_scheme_path', '')
        managed = ('', f'/usr/share/{generation}/colors/airy.conf',
                   f'/usr/share/{generation}/colors/darker.conf')
        if previous in managed and (root / scheme.lstrip('/')).is_file():
            update_ini(path, 'Appearance', {'color_scheme_path': scheme, 'custom_palette': 'true'})


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--mode', choices=('light', 'dark'), default='light')
    args = parser.parse_args()
    apply(Path('/'), args.mode, Path(os.environ.get('HOME', '/root')))

+static int new_child_setup(Tracee *parent, unsigned long pid, word_t clone_flags)
+{
+	int ptrace_options;
+	Tracee *child;
 
 	child = get_tracee(parent, (pid_t) pid, true);
 	if (child == NULL) {
@@ -628,6 +782,52 @@

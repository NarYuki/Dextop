diff --git a/tests/test_cursor_routing.cpp b/tests/test_cursor_routing.cpp
new file mode 100644
index 0000000..9c622db
--- /dev/null
+++ b/tests/test_cursor_routing.cpp
@@ -0,0 +1,42 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include "Utils/CursorRouting.h"
+
+using namespace gamescope;
+
+TEST_CASE("nested cursor composition can be forced without changing the default", "[cursor_routing]")
+{
+    REQUIRE_FALSE( CursorShouldBeComposited( 1, false, true, true, false ) );
+    REQUIRE( CursorShouldBeComposited( 2, false, true, true, false ) );
+
+    REQUIRE( CursorShouldBeComposited( 1, true, true, true, false ) );
+    REQUIRE( CursorShouldBeComposited( 1, false, true, false, false ) );
+    REQUIRE_FALSE( CursorShouldBeComposited( 0, true, true, false, true ) );
+    REQUIRE_FALSE( CursorShouldBeComposited( 1, false, false, false, false ) );
+    REQUIRE( CursorShouldBeComposited( 2, false, false, true, false ) );
+}
+
+TEST_CASE("manual composition retains only the no-focus default cursor fallback", "[cursor_routing]")
+{
+    REQUIRE_FALSE( CursorShouldBeForwardedToHost( 2, false ) );
+    REQUIRE( CursorShouldBeForwardedToHost( 2, true ) );
+    REQUIRE( CursorShouldBeForwardedToHost( 1, false ) );
+    REQUIRE( CursorShouldBeForwardedToHost( 0, false ) );
+}
+
+TEST_CASE("host cursor fallback follows the keyboard-focus and lock defaults", "[cursor_routing]")
+{
+    REQUIRE( CursorShouldUseHostFallback( true, true, false, true ) );
+    REQUIRE_FALSE( CursorShouldUseHostFallback( true, false, false, true ) );
+    REQUIRE_FALSE( CursorShouldUseHostFallback( true, true, true, true ) );
+    REQUIRE_FALSE( CursorShouldUseHostFallback( true, true, false, false ) );
+    REQUIRE( CursorShouldUseHostFallback( false, false, false, true ) );
+    REQUIRE_FALSE( CursorShouldUseHostFallback( false, true, true, true ) );
+}
+
+TEST_CASE("an empty or hidden client cursor stays hidden when composition is forced", "[cursor_routing]")
+{
+    REQUIRE_FALSE( CursorImageShouldBePainted( true, false ) );
+    REQUIRE_FALSE( CursorImageShouldBePainted( false, true ) );
+    REQUIRE( CursorImageShouldBePainted( false, false ) );
+}

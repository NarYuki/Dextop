diff --git a/src/Utils/CursorRouting.h b/src/Utils/CursorRouting.h
new file mode 100644
index 0000000..d7c21da
--- /dev/null
+++ b/src/Utils/CursorRouting.h
@@ -0,0 +1,36 @@
+#pragma once
+
+namespace gamescope
+{
+    constexpr bool CursorShouldBeComposited( int cursorCompositeMode, bool forceRelativeMouse,
+                                             bool hasFocus, bool hasNestedHints, bool nestedPaintsCursor )
+    {
+        if ( cursorCompositeMode == 2 )
+            return true;
+        if ( cursorCompositeMode == 0 )
+            return false;
+        if ( forceRelativeMouse )
+            return true;
+        if ( !hasFocus )
+            return false;
+        return !hasNestedHints || nestedPaintsCursor;
+    }
+
+    constexpr bool CursorShouldUseHostFallback( bool warpWithoutKeyboardFocus, bool pointerLocked,
+                                                bool keyboardEntered, bool hasDefaultCursor )
+    {
+        if ( warpWithoutKeyboardFocus )
+            return pointerLocked && !keyboardEntered && hasDefaultCursor;
+        return !keyboardEntered && hasDefaultCursor;
+    }
+
+    constexpr bool CursorShouldBeForwardedToHost( int cursorCompositeMode, bool useHostCursorFallback )
+    {
+        return cursorCompositeMode != 2 || useHostCursorFallback;
+    }
+
+    constexpr bool CursorImageShouldBePainted( bool imageEmpty, bool cursorHidden )
+    {
+        return !imageEmpty && !cursorHidden;
+    }
+}

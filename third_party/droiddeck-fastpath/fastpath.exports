/* Symbols the unprotected fast-path library exports. Everything else, including the
 * compiler runtime newer zig releases would otherwise export, stays local: a
 * preloaded library must not replace libc functions such as memcpy. */
{
  global:
    __fxstat;
    __fxstat64;
    __fxstatat;
    __fxstatat64;
    __getcwd_chk;
    __lxstat;
    __lxstat64;
    __open64_2;
    __open_2;
    __openat64_2;
    __openat_2;
    __readlink_chk;
    __readlinkat_chk;
    __realpath_chk;
    __xstat;
    __xstat64;
    accept;
    accept4;
    access;
    bind;
    canonicalize_file_name;
    chmod;
    connect;
    creat;
    creat64;
    eaccess;
    euidaccess;
    faccessat;
    fchmodat;
    fopen;
    fopen64;
    fstat;
    fstat64;
    fstatat;
    fstatat64;
    futimens;
    futimes;
    get_nprocs;
    getcwd;
    gethostname;
    getpeername;
    getpwnam;
    getpwnam_r;
    getpwuid;
    getpwuid_r;
    getsockname;
    getxattr;
    inotify_add_watch;
    isatty;
    lgetxattr;
    listxattr;
    llistxattr;
    lstat;
    lstat64;
    lutimes;
    memfd_create;
    mkdir;
    mkdirat;
    open;
    open64;
    openat;
    openat64;
    opendir;
    readlink;
    readlinkat;
    realpath;
    rename;
    renameat;
    renameat2;
    rmdir;
    shm_open;
    shm_unlink;
    stat;
    stat64;
    statfs;
    statfs64;
    statvfs;
    statvfs64;
    statx;
    symlink;
    symlinkat;
    sysconf;
    truncate;
    truncate64;
    uname;
    unlink;
    unlinkat;
    utime;
    utimensat;
    utimes;
  local: *;
};
